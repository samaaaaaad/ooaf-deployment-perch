        <mxCell id="users" value="&lt;b&gt;users&lt;/b&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt; user_id : UUID&lt;br&gt;full_name : VARCHAR NOT NULL&lt;br&gt;email : VARCHAR NOT NULL&lt;br&gt;email_normalized : VARCHAR UNIQUE NOT NULL&lt;br&gt;is_active : BOOLEAN NOT NULL&lt;br&gt;created_at : TIMESTAMP_TZ NOT NULL&lt;br&gt;updated_at : TIMESTAMP_TZ NOT NULL&lt;hr&gt;&lt;i&gt;Target account; no password or role.&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="45" y="155" width="300" height="300" as="geometry"/>
        </mxCell>
        <mxCell id="user-identities" value="&lt;b&gt;user_identities&lt;/b&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt; identity_id : UUID&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; user_id : UUID NOT NULL&lt;br&gt;issuer : VARCHAR NOT NULL&lt;br&gt;subject : VARCHAR NOT NULL&lt;br&gt;email_at_login : VARCHAR NULL&lt;br&gt;created_at : TIMESTAMP_TZ NOT NULL&lt;br&gt;last_login_at : TIMESTAMP_TZ NULL&lt;hr&gt;&lt;b&gt;UQ&lt;/b&gt; (issuer, subject)&lt;br&gt;&lt;i&gt;Google OIDC identity mapping.&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="390" y="155" width="320" height="300" as="geometry"/>
        </mxCell>
        <mxCell id="subscriptions" value="&lt;b&gt;subscriptions&lt;/b&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt; subscription_id : UUID&lt;br&gt;&lt;b&gt;FK/UQ&lt;/b&gt; user_id : UUID NOT NULL&lt;br&gt;status : ACTIVE | INACTIVE&lt;br&gt;billing_period : MONTHLY | YEARLY&lt;br&gt;starts_at : TIMESTAMP_TZ NOT NULL&lt;br&gt;expires_at : TIMESTAMP_TZ NOT NULL&lt;br&gt;square_customer_id : VARCHAR NULL&lt;br&gt;square_subscription_id : VARCHAR NULL&lt;br&gt;created_at : TIMESTAMP_TZ NOT NULL&lt;br&gt;updated_at : TIMESTAMP_TZ NOT NULL&lt;hr&gt;&lt;i&gt;Zero or one current subscription. Organiser capability = active and unexpired.&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="755" y="155" width="350" height="370" as="geometry"/>
        </mxCell>

        <mxCell id="venues" value="&lt;b&gt;venues&lt;/b&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt; venue_id : UUID&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; organiser_id → users.user_id&lt;br&gt;name : VARCHAR NOT NULL&lt;br&gt;address : VARCHAR NOT NULL&lt;br&gt;city : VARCHAR NOT NULL&lt;br&gt;state : VARCHAR NOT NULL&lt;br&gt;created_at : TIMESTAMP_TZ NOT NULL&lt;br&gt;updated_at : TIMESTAMP_TZ NOT NULL&lt;hr&gt;&lt;i&gt;Physical performance location. Performance time and timezone belong to the session.&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1180" y="155" width="350" height="370" as="geometry"/>
        </mxCell>
        <mxCell id="events" value="&lt;b&gt;events&lt;/b&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt; event_id : UUID&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; organiser_id → users.user_id&lt;br&gt;title : VARCHAR NOT NULL&lt;br&gt;description : CLOB NULL&lt;br&gt;status : DRAFT | PUBLISHED | CANCELLED | COMPLETED&lt;br&gt;published_at : TIMESTAMP_TZ NULL&lt;br&gt;created_at : TIMESTAMP_TZ NOT NULL&lt;br&gt;updated_at : TIMESTAMP_TZ NOT NULL&lt;hr&gt;&lt;i&gt;Production/tour; no venue or date here.&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1575" y="155" width="350" height="310" as="geometry"/>
        </mxCell>
        <mxCell id="event-sessions" value="&lt;b&gt;event_sessions&lt;/b&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt; session_id : UUID&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; event_id → events.event_id&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; venue_id → venues.venue_id&lt;br&gt;name : VARCHAR NOT NULL&lt;br&gt;starts_at : TIMESTAMP_TZ NOT NULL&lt;br&gt;ends_at : TIMESTAMP_TZ NOT NULL&lt;br&gt;timezone : VARCHAR NOT NULL&lt;br&gt;currency : CHAR(3) = AUD&lt;br&gt;hold_minutes : INTEGER = 10&lt;br&gt;max_assigned_per_booking : INTEGER NOT NULL&lt;br&gt;max_ga_per_booking : INTEGER NOT NULL&lt;br&gt;status : DRAFT | PUBLISHED | CANCELLED | COMPLETED&lt;br&gt;published_at : TIMESTAMP_TZ NULL&lt;br&gt;created_at : TIMESTAMP_TZ NOT NULL&lt;br&gt;updated_at : TIMESTAMP_TZ NOT NULL&lt;hr&gt;&lt;i&gt;One production can have many dated sessions across venues.&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1970" y="140" width="395" height="395" as="geometry"/>
        </mxCell>
        <mxCell id="publish-note" value="&lt;b&gt;Publish rule&lt;/b&gt;&lt;br&gt;After publication, event/session configuration and the copied layout are immutable. Operational status, holds, bookings and check-in can still change." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="2410" y="180" width="420" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="time-note" value="&lt;b&gt;Time rule&lt;/b&gt;&lt;br&gt;A future session uses Instant for starts_at and ends_at and stores its IANA timezone to render local wall-clock times and handle daylight saving." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="2410" y="365" width="420" height="150" as="geometry"/>
        </mxCell>

        <mxCell id="pricing-categories" value="&lt;b&gt;pricing_categories&lt;/b&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt; pricing_category_id : UUID&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; organiser_id → users.user_id&lt;br&gt;name : VARCHAR NOT NULL&lt;br&gt;default_price : DECIMAL(12,2) NOT NULL&lt;br&gt;colour : VARCHAR NULL&lt;br&gt;created_at : TIMESTAMP_TZ NOT NULL&lt;br&gt;updated_at : TIMESTAMP_TZ NOT NULL&lt;hr&gt;&lt;i&gt;Organiser-owned; no nullable alternate owner.&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="45" y="640" width="330" height="280" as="geometry"/>
        </mxCell>
        <mxCell id="floor-plans" value="&lt;b&gt;floor_plans&lt;/b&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt; floor_plan_id : UUID&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; organiser_id → users.user_id&lt;br&gt;name : VARCHAR NOT NULL&lt;br&gt;created_at : TIMESTAMP_TZ NOT NULL&lt;br&gt;updated_at : TIMESTAMP_TZ NOT NULL&lt;hr&gt;&lt;i&gt;Reusable organiser design created from an empty canvas; no system templates.&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="420" y="640" width="320" height="245" as="geometry"/>
        </mxCell>
        <mxCell id="floor-plan-floors" value="&lt;b&gt;floor_plan_floors&lt;/b&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt; floor_id : UUID&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; floor_plan_id → floor_plans.floor_plan_id&lt;br&gt;name : VARCHAR NOT NULL&lt;br&gt;level_number : INTEGER NOT NULL&lt;br&gt;width : DECIMAL(12,2) NOT NULL&lt;br&gt;height : DECIMAL(12,2) NOT NULL&lt;hr&gt;&lt;b&gt;UQ&lt;/b&gt; (floor_plan_id, level_number)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="785" y="640" width="340" height="260" as="geometry"/>
        </mxCell>
        <mxCell id="floor-plan-elements" value="&lt;b&gt;floor_plan_elements&lt;/b&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt; element_id : UUID&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; floor_id → floor_plan_floors.floor_id&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; pricing_category_id → pricing_categories.pricing_category_id NULL&lt;br&gt;element_type : SEAT | GA_SECTION | STAGE | TABLE | BARRIER | DECOR&lt;br&gt;label : VARCHAR NULL&lt;br&gt;x : DECIMAL(12,2) NOT NULL&lt;br&gt;y : DECIMAL(12,2) NOT NULL&lt;br&gt;width : DECIMAL(12,2) NOT NULL&lt;br&gt;height : DECIMAL(12,2) NOT NULL&lt;br&gt;rotation : DECIMAL(7,2) NOT NULL&lt;br&gt;sellable : BOOLEAN NOT NULL&lt;br&gt;capacity : INTEGER NULL&lt;br&gt;price_override : DECIMAL(12,2) NULL&lt;br&gt;properties : CLOB NULL&lt;hr&gt;&lt;i&gt;Reusable design elements only.&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1170" y="615" width="420" height="450" as="geometry"/>
        </mxCell>
        <mxCell id="session-layouts" value="&lt;b&gt;session_layouts&lt;/b&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt; session_layout_id : UUID&lt;br&gt;&lt;b&gt;FK/UQ&lt;/b&gt; session_id → event_sessions.session_id&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; source_floor_plan_id → floor_plans.floor_plan_id&lt;br&gt;locked_at : TIMESTAMP_TZ NULL&lt;br&gt;created_at : TIMESTAMP_TZ NOT NULL&lt;hr&gt;&lt;i&gt;Session creation requires a floor plan and immediately makes an independent copy—even if empty.&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1635" y="640" width="365" height="290" as="geometry"/>
        </mxCell>
        <mxCell id="session-layout-floors" value="&lt;b&gt;session_layout_floors&lt;/b&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt; session_floor_id : UUID&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; session_layout_id → session_layouts.session_layout_id&lt;br&gt;source_floor_id : UUID NULL&lt;br&gt;name : VARCHAR NOT NULL&lt;br&gt;level_number : INTEGER NOT NULL&lt;br&gt;width : DECIMAL(12,2) NOT NULL&lt;br&gt;height : DECIMAL(12,2) NOT NULL&lt;hr&gt;&lt;b&gt;UQ&lt;/b&gt; (session_layout_id, level_number)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="2045" y="640" width="365" height="300" as="geometry"/>
        </mxCell>
        <mxCell id="session-layout-elements" value="&lt;b&gt;session_layout_elements&lt;/b&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt; session_element_id : UUID&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; session_floor_id → session_layout_floors.session_floor_id&lt;br&gt;source_element_id : UUID NULL&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; pricing_category_id → pricing_categories.pricing_category_id NULL&lt;br&gt;element_type : SEAT | GA_SECTION | STAGE | TABLE | BARRIER | DECOR&lt;br&gt;label : VARCHAR NULL&lt;br&gt;x, y, width, height : DECIMAL(12,2)&lt;br&gt;rotation : DECIMAL(7,2) NOT NULL&lt;br&gt;sellable : BOOLEAN NOT NULL&lt;br&gt;enabled : BOOLEAN NOT NULL&lt;br&gt;capacity : INTEGER NULL&lt;br&gt;unit_price : DECIMAL(12,2) NULL&lt;br&gt;properties : CLOB NULL&lt;hr&gt;&lt;i&gt;Session-specific snapshot. Disable unavailable rows without altering the reusable plan.&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="2450" y="615" width="405" height="450" as="geometry"/>
        </mxCell>

        <mxCell id="bookings" value="&lt;b&gt;bookings&lt;/b&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt; booking_id : UUID&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; session_id → event_sessions.session_id&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; purchaser_id → users.user_id&lt;br&gt;booking_type : ASSIGNED | GENERAL_ADMISSION&lt;br&gt;status : HELD | CONFIRMED | EXPIRED | CANCELLED&lt;br&gt;hold_expires_at : TIMESTAMP_TZ NULL&lt;br&gt;total_amount : DECIMAL(12,2) NOT NULL&lt;br&gt;currency : CHAR(3) = AUD&lt;br&gt;created_at : TIMESTAMP_TZ NOT NULL&lt;br&gt;confirmed_at : TIMESTAMP_TZ NULL&lt;hr&gt;&lt;i&gt;Purchaser is separate from ticket attendees.&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="560" y="1170" width="390" height="330" as="geometry"/>
        </mxCell>
        <mxCell id="booking-items" value="&lt;b&gt;booking_items&lt;/b&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt; booking_item_id : UUID&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; booking_id → bookings.booking_id&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; session_element_id → session_layout_elements.session_element_id&lt;br&gt;quantity : INTEGER NOT NULL&lt;br&gt;unit_price : DECIMAL(12,2) NOT NULL&lt;br&gt;created_at : TIMESTAMP_TZ NOT NULL&lt;hr&gt;&lt;i&gt;Assigned items use quantity 1. GA items may use quantity &gt; 1.&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1010" y="1170" width="390" height="280" as="geometry"/>
        </mxCell>
        <mxCell id="tickets" value="&lt;b&gt;tickets&lt;/b&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt; ticket_id : UUID&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; booking_item_id → booking_items.booking_item_id&lt;br&gt;qr_token : VARCHAR UNIQUE NOT NULL&lt;br&gt;attendee_name : VARCHAR NULL&lt;br&gt;status : VALID | USED | CANCELLED&lt;br&gt;issued_at : TIMESTAMP_TZ NOT NULL&lt;br&gt;checked_in_at : TIMESTAMP_TZ NULL&lt;hr&gt;&lt;i&gt;One row and QR token per ticket; attendee name can be assigned later.&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1460" y="1170" width="370" height="285" as="geometry"/>
        </mxCell>
        <mxCell id="ticket-payments" value="&lt;b&gt;ticket_payments&lt;/b&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt; ticket_payment_id : UUID&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; booking_id → bookings.booking_id&lt;br&gt;attempt_number : INTEGER NOT NULL&lt;br&gt;status : PENDING | SUCCEEDED | FAILED | REFUNDED&lt;br&gt;amount : DECIMAL(12,2) NOT NULL&lt;br&gt;currency : CHAR(3) = AUD&lt;br&gt;square_payment_id : VARCHAR NULL&lt;br&gt;created_at : TIMESTAMP_TZ NOT NULL&lt;br&gt;updated_at : TIMESTAMP_TZ NOT NULL&lt;hr&gt;&lt;b&gt;UQ&lt;/b&gt; (booking_id, attempt_number)&lt;br&gt;&lt;i&gt;Square stub only; never store card data. Independent of subscriptions.&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1890" y="1170" width="410" height="330" as="geometry"/>
        </mxCell>
        <mxCell id="concurrency-note" value="&lt;b&gt;Transactional inventory rule&lt;/b&gt;&lt;br&gt;The service must lock/check the session element inside one transaction before creating or confirming a hold. Assigned seats cannot have overlapping active holds/confirmed sales; GA quantity cannot exceed capacity. Expired holds are ignored/released. Database constraints alone cannot express every active-state rule." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="2320" y="1170" width="290" height="330" as="geometry"/>
        </mxCell>

        <mxCell id="rules-note" value="&lt;b&gt;Cross-cutting conventions&lt;/b&gt;&lt;br&gt;• Java fields: camelCase (userId). Database identifiers: plural snake_case (users.user_id).&lt;br&gt;• UUID keys throughout. Monetary values: Java BigDecimal ↔ DECIMAL(12,2); never floating point.&lt;br&gt;• Email uniqueness uses a normalized lowercase value.&lt;br&gt;• H2 is the MVP database; the logical model avoids PostgreSQL-only types.&lt;br&gt;• Authentication is Google OIDC plus Spring Security’s server-side HttpSession. API bearer tokens, native apps and reseller access are outside MVP scope.&lt;br&gt;• A booking is assigned-seating or general-admission, never both. Enforce element-type compatibility in the service.&lt;br&gt;• Subscriptions grant organiser capability and are intentionally independent from ticket purchase payments." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="45" y="1560" width="1380" height="275" as="geometry"/>
        </mxCell>
        <mxCell id="tour-note" value="&lt;b&gt;Touring example&lt;/b&gt;&lt;br&gt;A circus owns one reusable floor plan. Each Miami/Tampa session receives its own copied layout. If Miami has 50 fewer usable rear seats, those copied session elements are disabled; the reusable floor plan and Tampa copy remain unchanged." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1465" y="1560" width="665" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="scope-note" value="&lt;b&gt;Scope marker&lt;/b&gt;&lt;br&gt;Blue entities are the immediate Jira #27 slice. Purple/green/orange entities document the agreed direction so today’s Event and Venue design does not block later work; they are not all part of Jira #27." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="2165" y="1560" width="690" height="160" as="geometry"/>
        </mxCell>

