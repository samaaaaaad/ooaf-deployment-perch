  <diagram id="jira-27" name="Jira 27 Implementation Slice">
    <mxGraphModel dx="1800" dy="1050" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1050" math="0" shadow="0">
      <root>
        <mxCell id="p2-0"/>
        <mxCell id="p2-1" parent="p2-0"/>
        <mxCell id="p2-title" value="&lt;b&gt;Jira #27 — Event &amp;amp; Venue entities + H2 DB setup&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;Implementation boundary: preserve the current User entity; add organiser-owned Event and Venue. No direct Event–Venue foreign key.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;fontColor=#1F2937;" vertex="1" parent="p2-1">
          <mxGeometry x="40" y="25" width="1500" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="p2-user" value="&lt;b&gt;users — existing/transitional&lt;/b&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt; user_id : UUID&lt;br&gt;full_name : VARCHAR NOT NULL&lt;br&gt;email : VARCHAR UNIQUE NOT NULL&lt;br&gt;password_hash : VARCHAR NOT NULL&lt;br&gt;role : VARCHAR NOT NULL&lt;br&gt;is_active : BOOLEAN NOT NULL&lt;hr&gt;&lt;i&gt;Preserved exactly for Jira #27. Google OIDC/user_identities and removal of password/role belong to later auth work.&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="p2-1">
          <mxGeometry x="80" y="210" width="390" height="310" as="geometry"/>
        </mxCell>
        <mxCell id="p2-event" value="&lt;b&gt;events — Jira #27&lt;/b&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt; event_id : UUID&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; organiser_id → users.user_id&lt;br&gt;title : VARCHAR NOT NULL&lt;br&gt;description : CLOB NULL&lt;br&gt;status : VARCHAR NOT NULL&lt;br&gt;published_at : TIMESTAMP_TZ NULL&lt;br&gt;created_at : TIMESTAMP_TZ NOT NULL&lt;br&gt;updated_at : TIMESTAMP_TZ NOT NULL&lt;hr&gt;&lt;i&gt;Represents the production/tour, not a dated performance.&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="p2-1">
          <mxGeometry x="650" y="210" width="410" height="330" as="geometry"/>
        </mxCell>
        <mxCell id="p2-venue" value="&lt;b&gt;venues — Jira #27&lt;/b&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt; venue_id : UUID&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; organiser_id → users.user_id&lt;br&gt;name : VARCHAR NOT NULL&lt;br&gt;address : VARCHAR NOT NULL&lt;br&gt;city : VARCHAR NOT NULL&lt;br&gt;state : VARCHAR NOT NULL&lt;br&gt;created_at : TIMESTAMP_TZ NOT NULL&lt;br&gt;updated_at : TIMESTAMP_TZ NOT NULL&lt;hr&gt;&lt;i&gt;Physical performance location. Session time and timezone are added later.&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="p2-1">
          <mxGeometry x="1250" y="180" width="430" height="390" as="geometry"/>
        </mxCell>
        <mxCell id="p2-session" value="&lt;b&gt;event_sessions — later task&lt;/b&gt;&lt;hr&gt;event_id → events.event_id&lt;br&gt;venue_id → venues.venue_id&lt;br&gt;starts_at / ends_at&lt;br&gt;session layout copy&lt;hr&gt;&lt;i&gt;This is the future association between a production and a physical venue. It is shown only to prevent adding venue_id to events now.&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f5f5f5;strokeColor=#a0a0a0;dashed=1;fontSize=13;opacity=75;" vertex="1" parent="p2-1">
          <mxGeometry x="790" y="680" width="430" height="250" as="geometry"/>
        </mxCell>
        <mxCell id="p2-note" value="&lt;b&gt;Jira #27 rules&lt;/b&gt;&lt;br&gt;• UUID primary keys; Java camelCase and plural snake_case database identifiers.&lt;br&gt;• H2 local file database with Hibernate ddl-auto for the lean MVP; tests use an isolated in-memory H2 database.&lt;br&gt;• Event and Venue authorisation: the current authenticated user may access a row only when its organiser_id equals that user’s user_id.&lt;br&gt;• Organiser capability will ultimately require an active, unexpired subscription; subscription/auth tables are not implemented by Jira #27.&lt;br&gt;• Future session timestamps use Instant/UTC and each session stores its IANA timezone.&lt;br&gt;• Once published, configuration is immutable. Publication logic is a later service concern." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="p2-1">
          <mxGeometry x="80" y="650" width="600" height="300" as="geometry"/>
        </mxCell>
        <mxCell id="p2-gap" value="&lt;b&gt;Intentional transition&lt;/b&gt;&lt;br&gt;The existing User still contains password_hash and role. That is not the final Google-only OIDC model, but changing it inside Jira #27 would mix authentication migration into the Event/Venue database task." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacing=10;fontSize=13;" vertex="1" parent="p2-1">
          <mxGeometry x="1280" y="680" width="400" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="p2-user-event" value="owns 0..*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERone;startFill=0;endArrow=ERmany;endFill=0;strokeColor=#64748b;strokeWidth=2;" edge="1" parent="p2-1" source="p2-user" target="p2-event"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2-user-venue" value="owns 0..*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERone;startFill=0;endArrow=ERmany;endFill=0;strokeColor=#64748b;strokeWidth=2;" edge="1" parent="p2-1" source="p2-user" target="p2-venue"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="600" y="140"/><mxPoint x="1460" y="140"/></Array></mxGeometry></mxCell>
        <mxCell id="p2-event-session" value="future" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERone;startFill=0;endArrow=ERmany;endFill=0;strokeColor=#a0a0a0;dashed=1;" edge="1" parent="p2-1" source="p2-event" target="p2-session"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2-venue-session" value="future" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERone;startFill=0;endArrow=ERmany;endFill=0;strokeColor=#a0a0a0;dashed=1;" edge="1" parent="p2-1" source="p2-venue" target="p2-session"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
