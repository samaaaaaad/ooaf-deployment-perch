        <mxCell id="catalogue-bg" value="EVENT CATALOGUE" style="swimlane;html=1;rounded=1;startSize=28;horizontal=1;fillColor=#f8fafc;strokeColor=#cbd5e1;fontStyle=1;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="1150" y="105" width="1735" height="455" as="geometry"/>
