        <mxCell id="identity-bg" value="IDENTITY &amp;amp; SUBSCRIPTION" style="swimlane;html=1;rounded=1;startSize=28;horizontal=1;fillColor=#f8fafc;strokeColor=#cbd5e1;fontStyle=1;fontColor=#475569;" vertex="1" parent="1">
